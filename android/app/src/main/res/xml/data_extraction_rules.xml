<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep the encrypted key store off both backup paths. The values inside it
  are encrypted with a key held in the device keystore, which is never
  transferred; a restored copy therefore cannot be decrypted, and the app
  would read it as "no key saved".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </device-transfer>
</data-extraction-rules>
