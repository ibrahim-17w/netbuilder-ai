              <TEXT>var port = 1234;
var socket;

function jsonParse(text, reviver) {
            var j;
            function walk(holder, key) {
                var k, v, value = holder[key];
                if (value &amp;&amp; typeof value === 'object') {
                    for (k in value) {
                        if (Object.prototype.hasOwnProperty.call(value, k)) {
                            v = walk(value, k);
                            if (v !== undefined) {
                                value[k] = v;
                            } else {
                                delete value[k];
                            }
                        }
                    }
                }
                return reviver.call(holder, key, value);
            }

            j = eval('(' + text + ')');
            return typeof reviver === 'function' ? walk({'': j}, '') : j;
}


function setup() {
	socket = new UDPSocket();
	
	// when receiving data
	socket.onReceive = function(ip, port, data) {
		Serial.println("received from "	+ ip + ":" + port + ": " + data);
		var commandData = jsonParse(data);
		if (commandData.data == "red") {
			digitalWrite(0, 1023);
			digitalWrite(1, 0);
			digitalWrite(2, 0);
		}
		else if (commandData.data == "green") {
			digitalWrite(1, 1023);
			digitalWrite(0, 0);
			digitalWrite(2, 0);
		}
		else if (commandData.data == "blue") {
			digitalWrite(2, 1023);
			digitalWrite(0, 0);
			digitalWrite(1, 0);
		}
	};
	
	// start UDP socket on port
	Serial.println(socket.begin(port));
}

