              <TEXT>var redPin = A0;
var greenPin = A1;
var bluePin = A2;
var red = 0;
var green = 0;
var blue = 0;
var MULTIPLIER = 255/1023;

var MAX_LIGHT_PERCENT = 2;
var VOLUME_AT_RATE = 100000;

function setup() {
	attachInterrupt(redPin, updateColor);
	attachInterrupt(greenPin, updateColor);
	attachInterrupt(bluePin, updateColor);
	
	updateColor();
}

//analogRead on red, green, and blue pin 
function updateColor() {
	red = Math.round(analogRead(redPin) * MULTIPLIER);
	green = Math.round(analogRead(greenPin) * MULTIPLIER);
	blue = Math.round(analogRead(bluePin) * MULTIPLIER);

	fillColor("led", red, green, blue);
	setDeviceProperty(getName(), "red", red);
	setDeviceProperty(getName(), "green", green);
	setDeviceProperty(getName(), "blue", blue);
}

var lastTimeInSeconds = 0;
function loop() {
	
	updateEnvironment();
	delay(1000);
}

function updateEnvironment() {
	var rate = (red+green+blue)/1000*MAX_LIGHT_PERCENT*VOLUME_AT_RATE / Environment.getVolume();
	// rate equals limit because we want it to happen immediately
	Environment.setContribution("Visible Light", rate, rate, false);
}
