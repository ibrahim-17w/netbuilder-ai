              <TEXT>from options import Options
from time import *
import math
from physical import *
from gpio import *
from environment import Environment
from ioeclient import IoEClient
#from pyjs import *


redPin = A0        # var redPin
greenPin = A1        # var greenPin
bluePin = A2        # var bluePin
red = 0        # var red
green = 0        # var green
blue = 0        # var blue
MULTIPLIER = 255. / 1023        # var MULTIPLIER

MAX_LIGHT_PERCENT = 2.        # var MAX_LIGHT_PERCENT
VOLUME_AT_RATE = 100000.        # var VOLUME_AT_RATE


def setup ():
    add_event_detect(redPin, updateColor)
    add_event_detect(greenPin, updateColor)
    add_event_detect(bluePin, updateColor)

    updateColor()


#analogRead on red, green, and blue pin

def updateColor ():
    global red, green, blue
    red = int(analogRead(redPin) * MULTIPLIER)
    green = int(analogRead(greenPin) * MULTIPLIER)
    blue = int(analogRead(bluePin) * MULTIPLIER)

    fillColor("led", red, green, blue)
    setDeviceProperty(getName(), "red", red)
    setDeviceProperty(getName(), "green", green)
    setDeviceProperty(getName(), "blue", blue)


lastTimeInSeconds = 0        # var lastTimeInSeconds


def loop ():

    updateEnvironment()
    delay(1000)



def updateEnvironment ():
    rate = (red + green + blue) / 1000 * MAX_LIGHT_PERCENT * VOLUME_AT_RATE / Environment.getVolume()        # var rate
    # rate equals limit because we want it to happen immediately
    Environment.setContribution("Visible Light", rate, rate, False)


if __name__ == "__main__":
    setup()
    while True:
        loop()
        sleep(0)

