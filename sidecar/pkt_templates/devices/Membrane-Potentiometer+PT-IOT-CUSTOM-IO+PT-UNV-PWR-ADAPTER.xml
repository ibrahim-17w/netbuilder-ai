              <TEXT>from time import *
from physical import *
from gpio import *
from pyjs import *



def setup ():
    analogWrite(A0, 0)
    setDeviceProperty(getName(), "level", 0)


# X region that makes up the softweb potentiometer.
# xMin is close to the plug and xMax is the end of the strip.
# The further from the plug, the higher the analog output will be.

region = JsObject({        # var region
    "xMin": 27,
    "xMax": 115
})

maxAnalog = 255        # var maxAnalog

# Purpose:
# Device update function.  Detect the touch position on potentiometer and convert it to an analog signal.

def mouseEvent (pressed, x, y, firstPress):

    output = 0        # var output
    if pressed:
        # Terminate if the touch goes out of range.
        if (x >= region.xMin) and (x &lt;= region.xMax):
            percent = ((x - region.xMin) / float(region.xMax - region.xMin))        # var percent
            output = percent * maxAnalog



    analogWrite(A0, output)
    setDeviceProperty(getName(), "level", output)


if __name__ == "__main__":
    setup()
    while True:
        #loop()
        sleep(3600)

