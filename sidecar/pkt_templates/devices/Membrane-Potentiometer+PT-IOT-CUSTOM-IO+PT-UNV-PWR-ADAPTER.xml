// X region that makes up the softweb potentiometer.
// xMin is close to the plug and xMax is the end of the strip.
// The further from the plug, the higher the analog output will be.
var region = {xMin: 27, xMax: 115};
var maxAnalog = 255;

// Purpose:
// Device update function.  Detect the touch position on potentiometer and convert it to an analog signal.
function mouseEvent(pressed, x, y, firstPress) {

	var output = 0;
	if(pressed)
	{
		// Terminate if the touch goes out of range.
		if((x >= region.xMin) &amp;&amp; (x &lt;= region.xMax))
		{
			var percent = ((x - region.xMin) / (region.xMax-region.xMin));
			output = percent * maxAnalog;
		}
	}
	
	analogWrite(A0, output);
	setDeviceProperty(getName(), "level", output);
}
