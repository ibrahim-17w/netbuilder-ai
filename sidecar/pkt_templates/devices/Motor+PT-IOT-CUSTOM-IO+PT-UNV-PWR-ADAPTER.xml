              <TEXT>from time import *
import math
from physical import *
from gpio import *
from environment import Environment
#from pyjs import *


# Purpose:
# A motor that is told what speed to run at through a slot.
# What capacity the engine is running at is stored in the property 'workCapacity', as a percentage [0, 100].
# 100 is full capacity.
# The motor read from an analog slot uses that to determine how hard the engine should be working.

# Current rotation to use for the gear.  This will always be in the 0,360 degrees range.
rotation = 0        # var rotation

# Rotation amount that an engine running at full capcity would use.
# Each update, this will be scaled by the work capacity and used to rotate the gear.
rotationToCapacity = 20        # var rotationToCapacity

# Customized code
# Purpose:
# Sets the ALLOY property that can be detected by a metal detector.
def setup():
	setDeviceProperty(getName(), 'ALLOY', 20);

# Purpose:
# Updates the engine.  Checks the current slot value and determines what speed the engine is running at.

def loop ():
    global rotation
    # Convert from the read value to actual value.
    workCapacity = 255 * (analogRead(A0) / 1023.)        # var workCapacity

    if workCapacity &lt; 0:
        workCapacity = 0
    elif workCapacity > 100:
        workCapacity = 100

    rotation += (rotationToCapacity * (workCapacity / 100.))
    while rotation > 360:
        rotation -= 360

    setProperty(workCapacity)
    setComponentRotation('Gear', rotation)

    setDeviceProperty(getName(), "rotation", rotation)


# Purpose:
# Get and set the angle property.
# These do not affect the display and are simply used for shortening code.

def getProperty ():
    return getDeviceProperty(getName(), 'workCapacity')



def setProperty (angle):
    setDeviceProperty(getName(), 'workCapacity', angle)


if __name__ == "__main__":
    setup()
    while True:
        loop()
        sleep(0.1)

