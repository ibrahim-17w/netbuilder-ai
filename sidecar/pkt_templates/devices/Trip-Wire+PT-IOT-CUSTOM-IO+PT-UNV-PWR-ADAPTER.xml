              <TEXT>from gpio import *
from time import *
from physical import *
import math

state = 0

def main():
    setup()
    while True:
        delay(1000)
        
def setup():
    global state
    setState(state)


def mouseEvent(pressed, x, y, firstPress):
    if (x > 5) and (x &lt; 40) and (y > 5) and (y &lt; 25):
        setState(1)
    else:
        setState(0)


def setState(newState):
    global state
    state = newState
    if  state is 0 :
        digitalWrite(0, LOW)
    else:
        digitalWrite(0, HIGH)
    setDeviceProperty(getName(), "state", state)

if __name__ == "__main__":
    main()</TEXT>
