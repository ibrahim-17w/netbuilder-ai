            <TEXT>from gpio import *
from time import *
from physical import *
from environment import *
import math

MAX_LIGHT_PERCENT = 3
VOLUME_AT_RATE = 100000
analogInput = 0

def setup():
    add_event_detect(A0, update)
    update()


def update():
    global analogInput
    analogInput = analogRead(A0)
    setComponentOpacity("black", (1-normalize(analogInput, 0, 1023)))
    setDeviceProperty(getName(), "level", analogInput)


def normalize(x, min, max):
    out = float(x-min)/(max-min)
    if  out &lt; min :
        out = min
    elif out > max:
        out = max
    return out

def main():
	setup()
	while True:
	    loop()
	
def loop():
    updateEnvironment()
    delay(1000)


def updateEnvironment():
    global analogInput
    global MAX_LIGHT_PERCENT
    global VOLUME_AT_RATE
    rate = float(analogInput)/1023*MAX_LIGHT_PERCENT*VOLUME_AT_RATE / Environment.getVolume()
    # rate equals limit because we want it to happen immediately
    Environment.setContribution("Visible Light", rate, rate, False)
    
if __name__ == "__main__":
    main()</TEXT>
