            <TEXT>from gpio import *
from physical import *
from time import *

state = 0 #0 off, 1 on

def main():
    global state
    add_event_detect(0, detect)
    setState(state)
    while True:
        delay(1000)

def detect():
    setState(digitalRead(0))
    
def setState(newState):
    global state
    state = newState
    if state == 0:
        digitalWrite(1, LOW)
        setDeviceProperty(getName(), "state", 0)
    else:
        digitalWrite(1,HIGH)
        setDeviceProperty(getName(), "state", 1)

if __name__ == "__main__":
    main()
