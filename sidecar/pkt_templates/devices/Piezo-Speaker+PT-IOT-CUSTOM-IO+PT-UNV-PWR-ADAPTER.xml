              <TEXT>var VOLUME_AT_RATE = 100000;
var SOUND_VOLUME = 10;
var SOUND_PITCH = 20;


// Purpose:
// Speaker that can play sound
var sound = {soundID: 'sound1', soundPath: '/../Sounds/buzzHigh.wav'};
var g_currSound = -1;                
var PIEZO_SOUND_OUTPUT = 95;
// Purpose:
// Setup the speaker.
function setup() {
	destroySounds();
	addSound(sound.soundID, sound.soundPath);
	setDeviceProperty(getName(), 'SOUND_dB', 0);
	
	attachInterrupt(0, function() {
		updateState();
	});
}

// Purpose:
// Update function.  Is called once each update.
function loop() {
	updateState();
	delay(1000);
}

// Purpose:
// Update the sound state, reading from the slot and playing the approperiate sound.
function updateState()
{
	var playValue = digitalRead(0);
	if (playValue)	{
		digitalWrite(1, HIGH);
		playSound(sound.soundID, 1);
		setDeviceProperty(getName(), 'SOUND_dB', PIEZO_SOUND_OUTPUT);
		g_currSound = 1;
	}
	else {
		digitalWrite(1, LOW);
		setDeviceProperty(getName(), 'SOUND_dB', 0);
		g_currSound = -1;
		
	}
	updateEnvironment();
}


function updateEnvironment()
{
	var volumeRatio = VOLUME_AT_RATE / Environment.getVolume();
	if (g_currSound >= 0) {
		Environment.setContribution("Sound Volume", SOUND_VOLUME*volumeRatio,  SOUND_VOLUME*volumeRatio, false);
		Environment.setContribution("Sound Pitch", SOUND_PITCH*(g_currSound+1), SOUND_PITCH*(g_currSound+1), false);
	}
	else {
		Environment.setContribution("Sound Volume", 0);
		Environment.setContribution("Sound Pitch", 0);
	}
}
