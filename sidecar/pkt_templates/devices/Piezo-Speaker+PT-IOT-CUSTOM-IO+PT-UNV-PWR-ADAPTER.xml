              <TEXT>from time import *
from physical import *
from gpio import *
from environment import Environment
from pyjs import *


VOLUME_AT_RATE = 100000.        # var VOLUME_AT_RATE
SOUND_VOLUME = 10.        # var SOUND_VOLUME
SOUND_PITCH = 20.        # var SOUND_PITCH


# Purpose:
# Speaker that can play sound

sound = JsObject({        # var sound
    "soundID": 'sound1',
    "soundPath": '/../Sounds/buzzHigh.wav'
})

g_currSound = -1        # var g_currSound
PIEZO_SOUND_OUTPUT = 95.        # var PIEZO_SOUND_OUTPUT
# Purpose:
# Setup the speaker.

def setup ():
    destroySounds()
    addSound(sound.soundID, sound.soundPath)
    setDeviceProperty(getName(), 'SOUND_dB', 0)

    add_event_detect(0, updateState)


# Purpose:
# Update function.  Is called once each update.

def loop ():
    updateState()
    sleep(1)


# Purpose:
# Update the sound state, reading from the slot and playing the approperiate sound.

def updateState ():
    playValue = digitalRead(0)        # var playValue
    if playValue:
        digitalWrite(1, HIGH)
        playSound(sound.soundID, 1)
        setDeviceProperty(getName(), 'SOUND_dB', PIEZO_SOUND_OUTPUT)
        g_currSound = 1
    else:
        digitalWrite(1, LOW)
        setDeviceProperty(getName(), 'SOUND_dB', 0)
        g_currSound = -1


    updateEnvironment()




def updateEnvironment ():
    volumeRatio = VOLUME_AT_RATE / Environment.getVolume()        # var volumeRatio
    if g_currSound >= 0:
        Environment.setContribution("Sound Volume", SOUND_VOLUME * volumeRatio, SOUND_VOLUME * volumeRatio, False)
        Environment.setContribution("Sound Pitch", SOUND_PITCH * (g_currSound + 1), SOUND_PITCH * (g_currSound + 1), False)
    else:
        Environment.setContribution("Sound Volume", 0, 0, False)
        Environment.setContribution("Sound Pitch", 0, 0, False)


if __name__ == "__main__":
    setup()
    while True:
        loop()
        sleep(0)

