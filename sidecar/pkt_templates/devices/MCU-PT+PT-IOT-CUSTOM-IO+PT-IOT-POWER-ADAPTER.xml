              <TEXT>var client = new RealHTTPClient();

function url(path){
	return "http://127.0.0.1:8765" + path	
}

function setup() {
	// when receiving data
	client.onDone = function(status, data) {
		Serial.println();
		Serial.println("status :     " + status);
		Serial.println("data   :     " + data.substring(0, 300));
	};
	
	client.postWithHeader(url("/services/add_numbers"), "n1=2&amp;n2=3", {Connection: "close"});
	client.postWithHeader(url("/contacts"), "id=abilyk", {Connection: "close"});
	client.getWithHeader(url("/hello.txt"), {Connection: "close"});
	client.getWithHeader(url("/dummy/dummy.png"), {Connection: "close"});
	client.postWithHeader(url("/"), "posted data", {Connection: "close"});
}

function loop() {
	delay(2000);
}
