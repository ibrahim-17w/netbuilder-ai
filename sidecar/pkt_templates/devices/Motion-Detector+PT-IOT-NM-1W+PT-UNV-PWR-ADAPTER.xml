    setState(1)


def loop():
    global state
    global current_time
    if  state == 1 :
        current_time = current_time - 1
        if  current_time &lt;= 0 :
            setState(0)

    sleep(1)


def setState(newState):
    global state
    global DEACTIVATE_TIMER
    global current_time
    state = newState

    if  state is 0 :
        digitalWrite(1, LOW)
    else:
        digitalWrite(1, HIGH)
        current_time = DEACTIVATE_TIMER


    IoEClient.reportStates(state)
    setDeviceProperty(getName(), "state", state)
    
if __name__ == "__main__":
    main()</TEXT>
