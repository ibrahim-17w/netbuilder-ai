    el_log = math.floor(math.log(electricity) / math.log(LOG_BASE))        # var el_log
    if el_log &lt; 0:
        el_log = 0
    elif el_log > 255:
        el_log = 255
    ##    print(el_log)
    analogWrite(0, el_log)





