              <TEXT>var output = 0;
var graphic = 1;
var state;

function setup() {
	// set initial button state
	update(false);
}

function mouseEvent(pressed, x, y, firstPressed) {
	if (firstPressed)
		update(true);
	else if (!pressed)
		update(false);
}

function update(newState) {
	if (newState !== state) {
		state = newState;
		// write to LED pin
		digitalWrite(graphic, state ? HIGH : LOW);
		digitalWrite(output, state ? HIGH : LOW);
	}
	
	setDeviceProperty(getName(), "state", state);
}
