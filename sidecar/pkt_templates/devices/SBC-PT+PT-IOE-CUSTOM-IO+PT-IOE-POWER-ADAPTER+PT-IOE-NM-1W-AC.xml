              <TEXT>var dstService = "{00000000-0000-0000-0000-000000000001}";
var dstMac = "FFFF.FFFF.FFFF";

var service;
var count = 0;

function setup() {
	Bluetooth.init();
	
	Bluetooth.onDevicePair = function(mac) {
		Serial.println('paired: ' + mac);
	};

	Bluetooth.onDeviceUnpair = function(mac) {
		Serial.println('unpaired: ' + mac);
	};

	Bluetooth.onDeviceConnect = function(mac) {
		Serial.println('connected: ' + mac);
	};

	Bluetooth.onDeviceDisconnect = function(mac) {
		Serial.println('disconnected: ' + mac);
	};
	
	// create service
	service = new BluetoothService();
	
	// when receiving data
	service.onReceive = function(srcMac, srcService, dstMac, dstService, data) {
		Serial.println("received from "
			+ srcMac + ":" + srcService + ": " + data);
	};
	
	// start service
	Serial.println(service.start(dstService));
}

function loop() {
	// send one msg every few secs
	service.send(dstMac, dstService, "hello " + (count++));
	delay(5000);
}
</TEXT>
