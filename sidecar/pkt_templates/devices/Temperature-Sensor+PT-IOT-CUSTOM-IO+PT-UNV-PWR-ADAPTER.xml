              <TEXT>from gpio import *
from time import *
from environment import *
from physical import *
from pyjs import *
import math

ENVIRONMENT_NAME = "Ambient Temperature"
MIN = -100
MAX = 100

def main():
    while True:
		loop()
		
def loop():
    global ENVIRONMENT_NAME
    global MIN
    global MAX
    value = Environment.get(ENVIRONMENT_NAME)
    if value &lt; MIN:
        value = MIN
    elif value > MAX:
        value = MAX

    setDeviceProperty(getName(), "level", value)
    value = math.floor(js_map(value, MIN, MAX, 0, 255))

    analogWrite(A0, value)
    analogWrite(0, value)
    delay(1000)

if __name__ == "__main__":
    main()</TEXT>
