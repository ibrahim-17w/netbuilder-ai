              <TEXT>from time import *
from physical import *
from gpio import *


is_open = False        # var is_open
P1 = 0        # var P1
PImage = 5        # var PImage


def setup ():
    update(is_open)



def mouseEvent (pressed, x, y, firstPress):
    # if mouse is first pressed, then flip it
    if firstPress:
        update(not is_open)



def update (open):
    global is_open
    is_open = open

    digitalWrite(PImage, ( HIGH  if is_open  else LOW ) )
    digitalWrite(P1, ( HIGH  if is_open  else LOW ) )

    setDeviceProperty(getName(), "state", is_open)


if __name__ == "__main__":
    setup()
    while True:
        #loop()
        sleep(3600)

