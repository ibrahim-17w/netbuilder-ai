              <TEXT>var is_open = false; 
var P1 = 0;
var P2 = 1;
var P3 = 2;
var P4 = 3;
var PImage = 5;

function setup() {
	attachInterrupt(P1, update);
	attachInterrupt(A0, update);
	
	update();
}

function mouseEvent(pressed, x, y, firstPress) {
	if (firstPress) {
		is_open = !is_open;
		update();
	}
}

function update() {

	digitalWrite(PImage, is_open ? HIGH : LOW);
	
	var p1 = is_open ? digitalRead(P1) : 0;
	var a0 = is_open ? (255.0*analogRead(A0)/1023.0) : 0;

    digitalWrite(P2, p1);
    digitalWrite(P3, p1);
    digitalWrite(P4, p1);
        
    analogWrite(A1, a0);
    analogWrite(A2, a0);
    analogWrite(A3, a0);
    
    setDeviceProperty(getName(), "state", is_open);

}
