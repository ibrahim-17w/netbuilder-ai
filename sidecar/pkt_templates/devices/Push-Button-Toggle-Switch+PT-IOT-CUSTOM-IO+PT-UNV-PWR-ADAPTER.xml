              <TEXT>from time import *
import math
from physical import *
from gpio import *

is_open = False        # var is_open
P1 = 0        # var P1
P2 = 1        # var P2
P3 = 2        # var P3
P4 = 3        # var P4
PImage = 5        # var PImage


def setup ():
    add_event_detect(P1, update)
    add_event_detect(A0, update)

    update()



def mouseEvent (pressed, x, y, firstPress):
    global is_open
    if firstPress:
        is_open = not is_open
        update()




def update ():

    digitalWrite(PImage, (HIGH if is_open else LOW) )

    p1 = ( digitalRead(P1)  if is_open  else 0. )        # var p1
    a0 = ( (255.0 * analogRead(A0) / 1023.0)  if is_open  else 0. )        # var a0

    digitalWrite(P2, p1)
    digitalWrite(P3, p1)
    digitalWrite(P4, p1)

    analogWrite(A1, a0)
    analogWrite(A2, a0)
    analogWrite(A3, a0)

    setDeviceProperty(getName(), "state", is_open)


if __name__ == "__main__":
    setup()
    while True:
#        loop()
        sleep(3600)

