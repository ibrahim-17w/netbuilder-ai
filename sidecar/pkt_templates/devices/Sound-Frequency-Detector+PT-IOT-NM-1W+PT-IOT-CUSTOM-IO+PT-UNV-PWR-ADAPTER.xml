from ioeclient import IoEClient


level = 0        # var level
unit = ""        # var unit


def setup ():

    
    IoEClient.setup({
        "type": "Sound Frequency Analyzer",
        "states": [{
            "name": "Value",
            "type": "number",
            "unit": unit,
            "controllable": False
        }]
    })
    

    setDeviceProperty(getName(), "environment", "Sound Pitch")
    sendReport()




def loop ():
    detect()
    sendReport()
    delay(1000)



def detect ():
    env = getDeviceProperty(getName(), "environment")        # var env
    setLevel(Environment.get(env))



