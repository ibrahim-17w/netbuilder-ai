    env = getDeviceProperty(getName(), "environment")        # var env
    setCustomText(20, 18, 200, 20, Environment.getValueWithUnit(env))
    analogWrite(A0, newLevel)
    level = newLevel


if __name__ == "__main__":
    setup()
    while True:
        loop()
        sleep(0)

