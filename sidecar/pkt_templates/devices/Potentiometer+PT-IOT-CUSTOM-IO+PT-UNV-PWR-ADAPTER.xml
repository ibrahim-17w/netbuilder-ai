function setup() {
	setComponentRotation("knob", 0);
	analogWrite(A0, 0);
	setDeviceProperty(getName(), "level", 0);
}

function mouseEvent(pressed, x, y, firstPress) {
	// record x and rotation when pressed changes
	if (firstPress) {
		pressedX = x;
		pressedRotation = rotation;
	}

	if (pressed &amp;&amp; (pressedX !== null)) {
		rotation = pressedRotation + (x - pressedX)*ROTATION_AMOUNT;
		if ( rotation > MAX_ROTATION )
			rotation = MAX_ROTATION;
		else if ( rotation &lt; 0 )
			rotation = 0;

		output = map(rotation, 0, MAX_ROTATION, 0, MAX_OUTPUT);

		setComponentRotation("knob", rotation);

		analogWrite(A0, output);
		setDeviceProperty(getName(), "level", output);
	} else
		pressedX = null;
}
