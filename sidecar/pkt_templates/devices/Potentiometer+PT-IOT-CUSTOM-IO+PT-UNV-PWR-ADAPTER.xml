              <TEXT>from gpio import * 
from time import *
from physical import * 

pressedX = None
pressedRotation = None
rotation=0
output=0
ROTATION_AMOUNT = 4
MAX_ROTATION = 230
MAX_OUTPUT = 255

def setup():
    setComponentRotation("knob", 0)
    analogWrite(A0, 0)
    setDeviceProperty(getName(), "level", 0)

def js_map(x, inMin, inMax, outMin, outMax):
    return (x - inMin) * (outMax - outMin) / (inMax - inMin) + outMin
	
def mouseEvent(pressed, x, y, firstPress):
    global pressedX, pressedRotation, rotation, output
    # record x and rotation when pressed changes
    if firstPress:
        pressedX = x
        pressedRotation = rotation

    if pressed and (pressedX is not None):
        rotation = pressedRotation + (x - pressedX)*ROTATION_AMOUNT
        if  rotation > MAX_ROTATION :
            rotation = MAX_ROTATION
        elif  rotation &lt; 0 :
            rotation = 0

        try:
            output = js_map(rotation, 0, MAX_ROTATION, 0, MAX_OUTPUT)
        except:
            pass
        setComponentRotation("knob", rotation)

        analogWrite(A0, output)
        setDeviceProperty(getName(), "level", output)
    else:
        pressedX = None

if __name__ == "__main__":
	setup()
	while True:
		sleep(3600)
