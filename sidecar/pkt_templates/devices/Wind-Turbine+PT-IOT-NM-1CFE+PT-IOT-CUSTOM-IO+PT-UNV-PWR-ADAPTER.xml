              <TEXT>//Wind Turbine
//Read the wind speed levels
//Output electricity based on wind speed

//Features output to IoE Server:
// number of kWh of energy produced since turning on
// number of kWh per minute
// current production
var ENVIRONMENT_NAME = "Wind Speed";
var MULTIPLIER = 255/1023;
var MAX_POWER = 1.2e7;//2 MW of power output (http://k0lee.com/turbineeff.htm)
var EFFICIENCY = 0.15;//About a 10 percent efficiency per turbine
var TURBINE_POWER = MAX_POWER * EFFICIENCY;
var LOG_BASE = 1.0749111034571373359815489867558;

var state = 1;
var electricity = 0;
//var tick = 0;

function setup(){
	
	IoEClient.setup({
		type: "Wind Turbine",
		states: [
			{
			name: "Power Output",
			type: "number",
			unit: 'kWh',
			controllable: false
			}
	 ]
	 });
	 
	sendReport();
}

function loop(){
//	if ( (tick++ % 10) === 0 )	// is tick consistent across devices? 
//	{
		// given the inertia of the turbine we smooth the output a bit
		electricity = electricity * 0.75 + Math.round(getElectricityProduction()) * 0.25; 
		sendReport();
		outputElectricity();
		delay(1000);
//	}
}

function value2displayText(electricity){
	return Math.floor(parseInt(electricity)/1000) + ' kWh';
}

function getElectricityProduction(){
	return TURBINE_POWER * Environment.get(ENVIRONMENT_NAME) / 100;
}

function sendReport()
{
	var report = state;	// comma seperated states
	customWrite(0, electricity);
	IoEClient.reportStates(Math.floor(electricity/1000));
	setDeviceProperty(getName(), "level", value2displayText(electricity));
}

function outputElectricity(){
	var el_log = Math.floor(Math.log(electricity)/Math.log(LOG_BASE));
	if(el_log &lt; 0)
		el_log = 0;
	else if (el_log > 255)
		el_log = 255;
	analogWrite(0, el_log);
}

