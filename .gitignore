migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local app/runtime state and generated Packet Tracer evidence
.mimosa/
dist/
sidecar/.mimosa/
sidecar/__pycache__/
sidecar/*.jsonl
sidecar/*_memory.json
sidecar/cal.json
sidecar/*.log
sidecar/*.png
sidecar/shots/
sidecar/pkt_backups/
sidecar/pkt_output/
# Offline generator: template library extracted from the user's own .pkt
# files (machine-local by design - nothing Cisco-authored is committed) and
# the generated demo artifacts.
sidecar/pkt_templates/
sidecar/*.pkt

# Platform-generated dependencies and intermediates
android/.gradle/
android/build/
android/.cxx/
android/local.properties
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
windows/flutter/ephemeral/

# Local reports, integration plans, and mutable sidecar state
/analyze_out.txt
sidecar/.pytest_out.txt
sidecar/pytest_out.txt
sidecar/_tmp_*.json
sidecar/_offline_plan_*.json
