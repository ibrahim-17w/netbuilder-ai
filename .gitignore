# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local app/runtime state and generated Packet Tracer evidence
.mimosa/
dist/
sidecar/.mimosa/
sidecar/__pycache__/
sidecar/*.jsonl
sidecar/*_memory.json
sidecar/cal.json
sidecar/*.log
sidecar/*.png
sidecar/shots/
sidecar/pkt_backups/
sidecar/pkt_output/
# Generated saves are scratch, except the one a test fixture reads.
sidecar/*.pkt
# demo-lab.pkt is a hand-kept fixture, not a generated save:
# test/on_device_pkt_builder_test.dart, test/pkt_builder_test.dart and
# test/seed_library_test.dart all open it, so a fresh clone needs it too.
!sidecar/demo-lab.pkt

# Debug scratch: throwaway probes, dumps and one-off patch scripts that a
# session leaves behind. None is source - the one file a test reads
# (`_offline_plan_brief.json`) is blanket-ignored by the generic pattern
# below, so it is explicitly un-ignored there to keep a fresh clone whole.
_tmp_*
_verify_*
_analyze_*
_patch_ai*
flutter_*.log
_android_*
*layout_ref.json

# Platform-generated dependencies and intermediates
android/.gradle/
android/build/
android/.cxx/
android/local.properties
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
windows/flutter/ephemeral/

# Local reports, integration plans, and mutable sidecar state
/analyze_out.txt
sidecar/.pytest_out.txt
sidecar/pytest_out.txt

# Python test tooling artifacts (regenerated by every pytest / coverage run)
**/__pycache__/
**/.pytest_cache/
**/.coverage
**/htmlcov/
sidecar/_tmp_*.json
sidecar/_offline_plan_*.json
# ...except the hand-authored learning brief the Python tests read; the
# blanket rule above would happily eat it.
!sidecar/_offline_plan_brief.json
sidecar/pkt_learning.json
sidecar/run_ledger.json
# Aggregated learning-loop counters: regenerated from the journal on this
# machine, describes this install rather than the source.
sidecar/journal_aggregate.json
sidecar/strategy_memory.json.v1.bak
